# Copy to .env and fill in. NEVER commit the real .env file.
# In GitHub Actions these are provided as repository secrets instead.

# ---- Email (SMTP) — the active notification channel ----
# For Gmail: host=smtp.gmail.com, port=587, username=your full Gmail address,
# password=a 16-char App Password (NOT your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# ---- Telegram (optional, disabled by default) ----
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-here
# TELEGRAM_CHAT_ID=123456789
